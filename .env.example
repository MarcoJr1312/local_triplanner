# Optional Docker Compose overrides. Copy to .env (gitignored).
# Values below are the defaults; change only what you need.

WEB_PORT=3000
POSTGRES_PORT=5432
MONGO_PORT=27017
# Demo Mongo credentials. Use a secret manager outside the demo.
MONGO_USERNAME=triplanner
MONGO_PASSWORD=triplanner
INTERNAL_TOKEN=dev-internal-token

# ---- Trips service (M9 cutover) ----
# local: the API keeps the legacy Postgres tables.
# remote: the API calls the trips service on :4400.
TRIPS_MODE=local
TRIPS_URL=http://trips:4400
# Must exceed the trips service's locations timeout (2 s) plus DB work.
TRIPS_TIMEOUT_MS=5000
# Trips database credentials (Compose demo defaults).
TRIPS_POSTGRES_USER=trips
TRIPS_POSTGRES_PASSWORD=trips
TRIPS_POSTGRES_DB=trips

# Docker Hub images (docker-compose.hub.yml)
DOCKERHUB_USERNAME=marcojr13
IMAGE_TAG=latest

# ---- LLM provider defaults (agent) ----
# The app's Profile / Settings panel can override these at runtime.
# none | deepseek | openai | anthropic | ollama
LLM_PROVIDER=none
# Key for deepseek/openai/anthropic. Not needed for none or a local Ollama.
LLM_API_KEY=
# Provider model id (e.g. deepseek-v4-pro, gpt-4o-mini, claude-sonnet-4-5)
LLM_MODEL=
# Optional base URL. Ollama on the host: http://host.docker.internal:11434/v1
LLM_BASE_URL=
