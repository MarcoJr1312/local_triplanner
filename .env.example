# Optional Docker Compose overrides. Copy to .env (gitignored).
# Values below are the defaults; change only what you need.

WEB_PORT=3000
POSTGRES_PORT=5432
MONGO_PORT=27017
INTERNAL_TOKEN=dev-internal-token

# ---- LLM provider (agent) ----
# none | deepseek | openai | anthropic | ollama
LLM_PROVIDER=none
# Key for deepseek/openai/anthropic. Not needed for none or a local Ollama.
LLM_API_KEY=
# Provider model id (e.g. deepseek-v4-pro, gpt-4o-mini, claude-sonnet-4-5)
LLM_MODEL=
# Optional base URL. Ollama on the host: http://host.docker.internal:11434/v1
LLM_BASE_URL=
