      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(rate(triplanner_http_requests_total{service=\"agent\",route=~\"$route\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(triplanner_http_requests_total{service=\"agent\",route=~\"$route\"}[$__rate_interval])), 0.001)) or vector(0)",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "5xx ratio",
      "type": "stat"
    },
