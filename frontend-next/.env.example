# Config del proxy /api/graphql (SOLO server-side, nunca NEXT_PUBLIC_*).
# El navegador solo habla con Next; el route handler reenvia al backend local.
NEXT_PRIVATE_BACKEND_URL=http://localhost:4000/graphql

# Modo demo local (login sin Firebase). Default: true.
NEXT_PUBLIC_DEMO_AUTH_ENABLED=true

# Firebase Auth (opcional). Si faltan estas 4 variables, Firebase queda
# deshabilitado y la app usa el modo demo.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
