# Ejemplo de configuracion del entorno local (dev/staging)
# Copia este archivo a .env y completa los valores. .env NUNCA se commitea.

# Key de HasData (https://app.hasdata.com/api-keys) — solo la usa el backend local
HASDATA_API_KEY=

# Key de Resend (https://resend.com/api-keys) — solo la usa el backend local
# Free tier: envia solo al email verificado de la cuenta (100/dia)
RESEND_API_KEY=

# Remitente de los emails. Default: 'Triplanner <onboarding@resend.dev>' (testing).
# Con dominio verificado: 'Triplanner <viajes@tudominio.com>'
RESEND_FROM=Triplanner <onboarding@resend.dev>

# Base publica del frontend para los links magicos de invitacion (server-side)
APP_URL=http://localhost:3000

# Puerto del servidor GraphQL local (default 4000)
LOCAL_PORT=4000
# Secreto HMAC para URLs firmadas de adjuntos (exp 15 min).
# En dev sin definir usa 'dev-attachment-secret'; en produccion definirlo.
ATTACHMENT_TOKEN_SECRET=


# Token interno de los endpoints REST /internal/* (agentes internos, ej. M3).
# En dev sin definir usa un default seguro 'dev-internal-token' (warning al boot).
INTERNAL_TOKEN=

# Base del servicio agente (FastAPI). El backend lo llama para sincronizar
# intereses (POST /internal/interests/sync). Default: http://127.0.0.1:4100
AGENT_BASE_URL=http://127.0.0.1:4100

# Firebase Auth (publica: config web del proyecto triplanner-a0e06)
FIREBASE_PROJECT_ID=triplanner-a0e06
FIREBASE_WEB_API_KEY=AIzaSyBGQHH9rg_ozTQlUbR71b-qza-ZwNDmMBk

# Service account del Admin SDK (genera links de verificacion sin enviar email).
# Default: local/firebase-service-account.json (no se commitea, ver .gitignore)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
