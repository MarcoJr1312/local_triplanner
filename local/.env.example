# Ejemplo de configuracion del entorno local (dev).
# Copia este archivo a .env y completa los valores. .env NUNCA se commitea.

# Base publica del frontend para los links de invitacion (server-side)
APP_URL=http://localhost:3000

# Puerto del servidor GraphQL local (default 4000)
LOCAL_PORT=4000

# Postgres (relacional + pgvector para el agente)
DATABASE_URL=postgres://triplanner:triplanner@localhost:5432/triplanner

# MongoDB (catalogo de lugares)
MONGODB_URL=mongodb://localhost:27017/triplanner

# Secreto HMAC para URLs firmadas de adjuntos (exp 15 min).
ATTACHMENT_TOKEN_SECRET=

# Token interno de los endpoints REST /internal/* (agente).
# En dev sin definir usa 'dev-internal-token' (warning al boot).
INTERNAL_TOKEN=

# Base del servicio agente (FastAPI).
AGENT_BASE_URL=http://127.0.0.1:4100

# Uploads: por defecto local/server/uploads. Override opcional:
# TRIPLANNER_UPLOADS_OVERRIDE=
