# Copiar a .env y completar (NUNCA commitear .env — ver .gitignore).
#
# Key de DeepSeek (obligatoria para el LLM).
DEEPSEEK_API_KEY=
# Secreto compartido con el backend local (/internal/*). En dev el backend usa
# 'dev-internal-token' por defecto (local/server/src/env.ts).
INTERNAL_TOKEN=dev-internal-token
# Service account del Firebase Admin SDK (default: firebase-service-account.json,
# el mismo que usa el backend local).
AGENT_FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-service-account.json
# Proyecto cuyos tokens se verifican.
FIREBASE_PROJECT_ID=triplanner-a0e06
# Modelo LLM (opcional).
AGENT_LLM_MODEL=deepseek-v4-pro
