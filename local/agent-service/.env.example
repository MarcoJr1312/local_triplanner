# Copiar a .env y completar (NUNCA commitear .env — ver .gitignore).
#
# Key del proveedor LLM (opcional en modo demo).
DEEPSEEK_API_KEY=
# Secreto compartido con el backend local (/internal/*). En dev el backend usa
# 'dev-internal-token' por defecto (local/server/src/env.ts).
INTERNAL_TOKEN=dev-internal-token
# Modelo LLM (opcional).
AGENT_LLM_MODEL=deepseek-v4-pro
# Endpoint OpenAI-compatible (opcional; por defecto DeepSeek).
AGENT_LLM_BASE_URL=https://api.deepseek.com
# Postgres con pgvector: misma base que el backend.
DATABASE_URL=postgres://triplanner:triplanner@localhost:5432/triplanner
# Backend interno (Compose: http://api:4000).
BACKEND_URL=http://127.0.0.1:4000
