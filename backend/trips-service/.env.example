# Trips service (local development)
PORT=4400
INTERNAL_TOKEN=dev-internal-token

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=trips
POSTGRES_USER=trips
POSTGRES_PASSWORD=trips
# Optional full DSN; overrides the discrete fields when set.
# TRIPS_DATABASE_URL=postgres://trips:trips@127.0.0.1:5432/trips

SEED_DEMO=false

LOCATIONS_URL=http://127.0.0.1:4300
LOCATIONS_TIMEOUT_MS=2000

BROKER_URL=http://127.0.0.1:8080
BROKER_TOPIC=TripInvitation
BROKER_TIMEOUT_MS=3000
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=20

SHUTDOWN_TIMEOUT_MS=10000
