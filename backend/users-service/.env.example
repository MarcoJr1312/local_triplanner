# Users service (local development)
PORT=4500
INTERNAL_TOKEN=dev-internal-token

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=users
POSTGRES_USER=users
POSTGRES_PASSWORD=users
# Optional full DSN; overrides the discrete fields when set.
# USERS_DATABASE_URL=postgres://users:users@127.0.0.1:5432/users

SEED_DEMO=false

DB_CONNECT_ATTEMPTS=30
DB_CONNECT_DELAY_MS=500
SHUTDOWN_TIMEOUT_MS=10000
