PORT=4300
MONGODB_HOST=127.0.0.1:27017
MONGODB_DB=triplanner
MONGODB_COLLECTION=locations
# Demo only; use a secret manager in production.
MONGODB_USERNAME=triplanner
MONGODB_PASSWORD=triplanner
MONGODB_AUTH_SOURCE=admin
INTERNAL_TOKEN=dev-internal-token
SEED_CATALOGUE=true
SETTINGS_FILE=.data/locations.json

# Optional seed for the BYOK key. The Settings UI can override it at runtime.
HASDATA_API_KEY=
HASDATA_API_BASE=https://api.hasdata.com/scrape/google-maps
# Cached HasData rows expire after 5 days.
HASDATA_CACHE_TTL_HOURS=120
HASDATA_TIMEOUT_MS=8000
HASDATA_HL=en
HASDATA_GL=ca
