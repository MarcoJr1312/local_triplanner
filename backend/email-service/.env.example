# Triplanner email-service — local development defaults.
# Copy to backend/email-service/.env (git-ignored) and adjust.

# ---- Kafka ----
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=triplanner-email-service
KAFKA_GROUP_ID=triplanner-email-service
KAFKA_TOPIC=triplanner.email.requests.v1
KAFKA_DLQ_TOPIC=triplanner.email.requests.v1.dlq
KAFKA_SSL=false
# KAFKA_SSL_CA_PATH=/etc/triplanner/kafka/ca.pem
# KAFKA_SSL_REJECT_UNAUTHORIZED=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# Creates the request and DLQ topics on boot. Keep false in Kubernetes: the
# chart/operator or a migration Job owns topic creation.
KAFKA_ENSURE_TOPICS=true
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ---- Email provider ----
# 'resend' delivers; 'sink' logs and drops (local UI work without a key).
EMAIL_PROVIDER=sink
RESEND_API_KEY=
RESEND_FROM=Triplanner <onboarding@resend.dev>
# RESEND_REPLY_TO=support@example.com
# RESEND_ENDPOINT=https://api.resend.com/emails
RESEND_TIMEOUT_MS=10000

# ---- Delivery ----
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=500

# ---- Runtime ----
APP_URL=http://localhost:3000
HEALTH_PORT=4200
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
