# Triplanner email-service — local development defaults.
# Copy to backend/email-service/.env (git-ignored) and adjust.

# ---- Go demo broker ----
BROKER_URL=http://127.0.0.1:8080
BROKER_TOPIC=TripInvitation
BROKER_CONSUMER=email-service
BROKER_DLQ_TOPIC=TripInvitation.dlq
BROKER_BATCH_SIZE=10
# Long-poll seconds. Keep BROKER_REQUEST_TIMEOUT_MS greater than this.
BROKER_WAIT_SECONDS=20
BROKER_REQUEST_TIMEOUT_MS=35000
BROKER_RETRY_DELAY_MS=1000

# ---- Email provider ----
# 'resend' delivers; 'sink' logs and drops (local UI work without a key).
EMAIL_PROVIDER=sink
RESEND_API_KEY=
RESEND_FROM=Triplanner <onboarding@resend.dev>
# RESEND_REPLY_TO=support@example.com
# RESEND_ENDPOINT=https://api.resend.com/emails
RESEND_TIMEOUT_MS=10000

# ---- Delivery ----
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=500

# ---- BYOK settings ----
INTERNAL_TOKEN=dev-internal-token
EMAIL_SETTINGS_FILE=.data/email.json

# ---- Runtime ----
APP_URL=http://localhost:3000
HEALTH_PORT=4200
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
