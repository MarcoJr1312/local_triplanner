{
  "name": "triplanner-local-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triplanner local GraphQL API built with Bun, graphql-yoga and PostgreSQL; catalogue reads go to the locations service.",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/seed.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "graphql-yoga": "^5.13.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
