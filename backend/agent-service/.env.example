# Copiar a .env y completar (NUNCA commitear .env — ver .gitignore).
#
# Proveedor LLM: none | deepseek | openai | anthropic | ollama
# none = respuestas deterministas del catálogo local (sin key).
LLM_PROVIDER=none
# Key del proveedor (no hace falta para none ni para Ollama local).
LLM_API_KEY=
# Modelo del proveedor (opcional; cada proveedor tiene su default).
LLM_MODEL=
# Endpoint opcional. Para Ollama en el host: http://127.0.0.1:11434/v1
LLM_BASE_URL=

# Secreto compartido con locations (/internal/*).
INTERNAL_TOKEN=dev-internal-token
# Token del API cuando corre en otro stack (Helm agent + Compose API).
BACKEND_INTERNAL_TOKEN=
# PostgreSQL 17 + pgvector propios del agente.
DATABASE_URL=postgres://agent:agent@127.0.0.1:5433/agent
# Alternativa a DATABASE_URL: POSTGRES_HOST/PORT/DB/USER/PASSWORD.

# API facade para contexto de viaje y chat.
BACKEND_URL=http://127.0.0.1:4000
# Locations service para snapshot y enriquecimiento.
LOCATIONS_URL=http://127.0.0.1:4300
LOCATIONS_TIMEOUT_MS=8000
# Broker de cambios.
BROKER_URL=http://127.0.0.1:8080
BROKER_TOPIC=LocationChanged
BROKER_CONSUMER=agent-locations
# Reconciliación y umbral de enriquecimiento.
SYNC_INTERVAL_MS=300000
AGENT_MATCH_THRESHOLD=60
AGENT_ENRICH_LIMIT=20
