# Copiar a .env y completar (NUNCA commitear .env — ver .gitignore).
#
# Proveedor LLM: none | deepseek | openai | anthropic | ollama
# none = respuestas deterministas del catálogo local (sin key).
LLM_PROVIDER=none
# Key del proveedor (no hace falta para none ni para Ollama local).
LLM_API_KEY=
# Modelo del proveedor (opcional; cada proveedor tiene su default).
LLM_MODEL=
# Endpoint opcional. Para Ollama en el host: http://127.0.0.1:11434/v1
LLM_BASE_URL=

# Secreto compartido con el backend local (/internal/*).
INTERNAL_TOKEN=dev-internal-token
# Postgres con pgvector: misma base que el backend.
DATABASE_URL=postgres://triplanner:triplanner@127.0.0.1:5432/triplanner
# Backend interno (Compose: http://api:4000).
BACKEND_URL=http://127.0.0.1:4000
